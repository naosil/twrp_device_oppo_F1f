# mount point       fstype    device                                        flags 
/system             ext4      /dev/block/bootdevice/by-name/system
/system_image       emmc      /dev/block/bootdevice/by-name/system          flags=backup=1;flashimg=1
/data               ext4      /dev/block/bootdevice/by-name/userdata        flags=encryptable=footer;length=-16384
/cache              ext4      /dev/block/bootdevice/by-name/cache
/boot               emmc      /dev/block/bootdevice/by-name/boot            flags=backup=1;flashimg=1
/recovery           emmc      /dev/block/bootdevice/by-name/recovery        flags=backup=1:flashimg=1
/misc               emmc      /dev/block/bootdevice/by-name/misc
/persist            ext4      /dev/block/bootdevice/by-name/persist         flags=backup=1;display="Persist"
/firmware           vfat      /dev/block/bootdevice/by-name/modem           flags=mounttodecrypt;fsflags=ro;display="Firmware"
/modem_st1          emmc      /dev/block/bootdevice/by-name/modemst1        flags=backup=1;display="Modem_st1"
/modem_st2          emmc      /dev/block/bootdevice/by-name/modemst2        flags=backup=1;display="Modem_st2"
/static_nv_bk       emmc      /dev/block/bootdevice/by-name/oppostanvbk     flags=backup=1;display="Static_nv_bk"
/oppodycnvbk        emmc      /dev/block/bootdevice/by-name/oppodycnvbk     flags=backup=1;display="Oppodycnvbk"
/external_sd        vfat      /dev/block/mmcblk1p1                          flags=removable;storage;wipeingui;display="Micro SD"
